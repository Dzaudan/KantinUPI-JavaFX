
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.detailController"
            stylesheets="@styles/app.css">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label text="Kantin UPI Purwakarta - Detail Produk" styleClass="title"/>
            <Button text="Lihat Daftar" onAction="#bukaDaftar"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="10" styleClass="card">
                        <Label text="Kode Produk" styleClass="muted"/>
                        <Label fx:id="kodeLabel" styleClass="subtitle"/>
                        
                        <Label text="Nama Produk" styleClass="muted"/>
                        <Label fx:id="namaLabel" wrapText="true"/>
                        
                        <Label text="Kategori" styleClass="muted"/>
                        <Label fx:id="kategoriLabel"/>
                        
                        <Label text="Harga" styleClass="muted"/>
                        <Label fx:id="hargaLabel" styleClass="title"/>
                        
                        <Label fx:id="pesanLabel" wrapText="true" styleClass="error"/>
                        
                        <HBox spacing="10">
                            <Button text="Tambah Produk Lain" onAction="#bukaForm" styleClass="button-primary"/>
                            <Button text="Ke Daftar Menu" onAction="#bukaDaftar"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>